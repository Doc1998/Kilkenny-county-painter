---
title: 'Thank You | Kilkenny County Painters'
description: 'Thank you for contacting Kilkenny County Painters. We have received your enquiry and will be in touch shortly with your free quote.'
preloadImg: '/assets/images/thank-you-hero.jpg'
permalink: '/thank-you/'
---

{% extends "layouts/base.html" %}

{% block head %}
{% endblock %}

{% block body %}
<style>
  :root {
    --pd-primary: #1A1A1A;
    --pd-accent: #D32F2F;
    --pd-light: #F4F6F9;
    --pd-white: #ffffff;
    --pd-font-display: 'Anton', sans-serif;
    --pd-font-body: 'Barlow', sans-serif;
  }

  .kilkenny-county-painters-thank-you *,
  .kilkenny-county-painters-thank-you *::before,
  .kilkenny-county-painters-thank-you *::after {
    box-sizing: border-box;
  }

  .kilkenny-county-painters-thank-you {
    width: 100%;
    overflow-x: hidden;
    font-family: var(--pd-font-body);
    color: var(--pd-primary);
    background: var(--pd-white);
  }

  /* ── HERO ── */
  .kilkenny-county-painters-thank-you .ty-hero {
    position: relative;
    background: var(--pd-primary);
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 20px 60px;
    overflow: hidden;
  }

  .kilkenny-county-painters-thank-you .ty-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.22;
    background: #2a2a2a;
  }

  .kilkenny-county-painters-thank-you .ty-hero__content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    width: 100%;
  }

  .kilkenny-county-painters-thank-you .ty-hero__eyebrow {
    display: inline-block;
    font-family: var(--pd-font-body);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--pd-accent);
    margin-bottom: 18px;
  }

  .kilkenny-county-painters-thank-you .ty-hero__h1 {
    font-family: var(--pd-font-display);
    font-size: clamp(2.6rem, 9vw, 5.2rem);
    line-height: 0.93;
    text-transform: uppercase;
    color: var(--pd-white);
    margin: 0 0 24px;
    overflow-wrap: break-word;
  }

  .kilkenny-county-painters-thank-you .ty-hero__highlight {
    position: relative;
    display: inline-block;
    color: var(--pd-primary);
    z-index: 1;
  }

  .kilkenny-county-painters-thank-you .ty-hero__highlight::before {
    content: '';
    position: absolute;
    inset: -4px -10px -4px -8px;
    background: var(--pd-accent);
    border-radius: 44% 56% 62% 38% / 58% 42% 60% 40%;
    transform: rotate(-1.5deg) skewX(-2deg);
    z-index: -1;
  }

  .kilkenny-county-painters-thank-you .ty-hero__sub {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: rgba(255,255,255,0.82);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  /* ── TORN DIVIDER ── */
  .kilkenny-county-painters-thank-you .ty-divider {
    display: block;
    width: 100%;
    line-height: 0;
    background: var(--pd-primary);
  }

  .kilkenny-county-painters-thank-you .ty-divider svg {
    display: block;
    width: 100%;
  }

  /* ── CONFIRMATION SECTION ── */
  .kilkenny-county-painters-thank-you .ty-confirm {
    background: var(--pd-light);
    padding: 64px 20px;
    text-align: center;
  }

  .kilkenny-county-painters-thank-you .ty-confirm__inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .kilkenny-county-painters-thank-you .ty-confirm__icon {
    width: 72px;
    height: 72px;
    background: var(--pd-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 28px;
    font-size: 2rem;
    color: var(--pd-white);
    flex-shrink: 0;
  }

  .kilkenny-county-painters-thank-you .section-title {
    font-family: var(--pd-font-display);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    text-transform: uppercase;
    line-height: 1.05;
    color: var(--pd-primary);
    margin: 0 0 16px;
    overflow-wrap: break-word;
  }

  .kilkenny-county-painters-thank-you .ty-confirm p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #444;
    margin: 0 0 14px;
    overflow-wrap: break-word;
  }

  /* ── STEPS SECTION ── */
  .kilkenny-county-painters-thank-you .ty-steps {
    background: var(--pd-white);
    padding: 64px 20px;
  }

  .kilkenny-county-painters-thank-you .ty-steps__inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .kilkenny-county-painters-thank-you .ty-steps__heading {
    text-align: center;
    margin-bottom: 44px;
  }

  .kilkenny-county-painters-thank-you .eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--pd-accent);
    margin-bottom: 10px;
  }

  .kilkenny-county-painters-thank-you .ty-steps__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: center;
  }

  .kilkenny-county-painters-thank-you .step-card {
    background: var(--pd-light);
    border-radius: 22px;
    padding: 32px 24px;
    flex: 1 1 220px;
    max-width: 260px;
    text-align: center;
    box-shadow: 0 18px 50px rgba(20,24,28,0.08);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .kilkenny-county-painters-thank-you .step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 56px rgba(20,24,28,0.14);
  }

  .kilkenny-county-painters-thank-you .step-card__num {
    font-family: var(--pd-font-display);
    font-size: 2.4rem;
    color: var(--pd-accent);
    line-height: 1;
    margin-bottom: 12px;
  }

  .kilkenny-county-painters-thank-you .step-card__title {
    font-family: var(--pd-font-display);
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pd-primary);
    margin-bottom: 8px;
  }

  .kilkenny-county-painters-thank-you .step-card p {
    font-size: 0.92rem;
    color: #555;
    line-height: 1.6;
    margin: 0;
    overflow-wrap: break-word;
  }

  /* ── REVIEW BAND ── */
  .kilkenny-county-painters-thank-you .ty-review {
    background: var(--pd-primary);
    padding: 56px 20px;
  }

  .kilkenny-county-painters-thank-you .ty-review__inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .kilkenny-county-painters-thank-you .ty-review__stars {
    font-size: 1.5rem;
    color: #FBBF24;
    letter-spacing: 0.1em;
    margin-bottom: 18px;
  }

  .kilkenny-county-painters-thank-you .ty-review__quote {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: rgba(255,255,255,0.88);
    font-style: italic;
    line-height: 1.7;
    margin: 0 0 16px;
    overflow-wrap: break-word;
  }

  .kilkenny-county-painters-thank-you .ty-review__author {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--pd-accent);
  }

  /* ── CTA BAND ── */
  .kilkenny-county-painters-thank-you .ty-cta {
    background: var(--pd-accent);
    padding: 72px 20px;
    text-align: center;
  }

  .kilkenny-county-painters-thank-you .ty-cta__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .kilkenny-county-painters-thank-you .ty-cta__heading {
    font-family: var(--pd-font-display);
    font-size: clamp(1.9rem, 6vw, 3.4rem);
    text-transform: uppercase;
    line-height: 0.96;
    color: var(--pd-white);
    margin: 0 0 18px;
    overflow-wrap: break-word;
  }

  .kilkenny-county-painters-thank-you .ty-cta p {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.88);
    margin: 0 0 32px;
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  .kilkenny-county-painters-thank-you .ty-cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  /* ── BUTTONS ── */
  .kilkenny-county-painters-thank-you .btn {
    display: inline-block;
    font-family: var(--pd-font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 16px 36px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .kilkenny-county-painters-thank-you .btn:focus-visible {
    outline: 3px solid var(--pd-white);
    outline-offset: 3px;
  }

  .kilkenny-county-painters-thank-you .btn--white {
    background: var(--pd-white);
    color: var(--pd-accent);
  }

  .kilkenny-county-painters-thank-you .btn--outline-white {
    background: transparent;
    color: var(--pd-white);
    border: 2px solid var(--pd-white);
  }

  .kilkenny-county-painters-thank-you .btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.22);
  }

  .kilkenny-county-painters-thank-you .btn--accent {
    background: var(--pd-accent);
    color: var(--pd-white);
  }

  /* ── RESPONSIVE ── */
  @media (min-width: 768px) {
    .kilkenny-county-painters-thank-you .ty-hero {
      min-height: 480px;
      padding: 100px 40px 80px;
    }

    .kilkenny-county-painters-thank-you .ty-confirm {
      padding: 80px 40px;
    }

    .kilkenny-county-painters-thank-you .ty-steps {
      padding: 80px 40px;
    }

    .kilkenny-county-painters-thank-you .ty-review {
      padding: 72px 40px;
    }

    .kilkenny-county-painters-thank-you .ty-cta {
      padding: 88px 40px;
    }
  }

  @media (min-width: 1024px) {
    .kilkenny-county-painters-thank-you .step-card {
      flex: 1 1 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kilkenny-county-painters-thank-you .btn,
    .kilkenny-county-painters-thank-you .step-card {
      transition: none;
    }
  }
</style>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Thank You | Kilkenny County Painters",
  "description": "Thank you for contacting Kilkenny County Painters. We've received your enquiry and will be in touch shortly with your free quote.",
  "url": "https://kilkennycountypainters.ie/thank-you/",
  "publisher": {
    "@type": "LocalBusiness",
    "name": "Kilkenny County Painters",
    "telephone": "+353873566934",
    "email": "kilkennycountypainter@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Kilkenny",
      "addressCountry": "IE"
    }
  }
}
</script>

<div class="kilkenny-county-painters-thank-you">

  <!-- HERO -->
  <section class="ty-hero" aria-labelledby="ty-h1">
    <img
      src="/assets/images/thank-you-hero.jpg"
      alt="Kilkenny County Painters team completing a painting project in Kilkenny"
      class="ty-hero__bg"
      width="1440"
      height="600"
      loading="lazy"
    >
    <div class="ty-hero__content">
      <span class="ty-hero__eyebrow">Enquiry Received</span>
