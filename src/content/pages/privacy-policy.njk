  .kilkenny-county-painters-privacy-policy .btn {
    display: inline-block;
    font-family: var(--pd-font-display);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 999px;
    background: var(--pd-white);
    color: var(--pd-accent);
    box-shadow: 0 18px 50px rgba(20,24,28,0.16);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .kilkenny-county-painters-privacy-policy .btn:hover,
  .kilkenny-county-painters-privacy-policy .btn:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 24px 60px rgba(20,24,28,0.22);
  }

  @media (prefers-reduced-motion: reduce) {
    .kilkenny-county-painters-privacy-policy .btn {
      transition: none;
    }
  }

  /* ── RESPONSIVE ── */
  @media (min-width: 768px) {
    .kilkenny-county-painters-privacy-policy .privacy-policy-hero {
