      <ul>
        <li>Email: <a href="mailto:kilkennycountypainter@gmail.com">kilkennycountypainter@gmail.com</a></li>
        <li>Phone: <a href="tel:+353838922620">+353 83 892 2620</a></li>
        <li>Address: Kilkenny, Ireland</li>
      </ul>

