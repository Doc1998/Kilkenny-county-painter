    </div>
  </section>



  <!-- FORM + DETAILS -->
  <section class="contact-main" aria-labelledby="contact-form-heading">
    <div class="contact-grid">

      <!-- LEFT: FORM -->
      <div class="form-card">
        <span class="section-eyebrow">Quick Quote Request</span>
        <h2 id="contact-form-heading">Tell Us About Your Project</h2>

        <form name="quote-contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
          <input type="hidden" name="form-name" value="quote-contact">
          <p hidden><label>Don't fill this out: <input name="bot-field"></label></p>

          <div class="form-row">
            <div class="form-group">
              <label for="contact-name">Full Name</label>
              <input type="text" id="contact-name" name="name" placeholder="Your name" required>
            </div>
            <div class="form-group">
              <label for="contact-email">Email Address</label>
              <input type="email" id="contact-email" name="email" placeholder="you@email.com" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="contact-phone">Phone Number</label>
              <input type="tel" id="contact-phone" name="phone" placeholder="+353 87 …" required>
            </div>
            <div class="form-group">
              <label for="contact-eircode">Eircode / Postcode</label>
              <input type="text" id="contact-eircode" name="eircode" placeholder="R95 XXXX" required>
            </div>
          </div>

          <div class="form-group" style="margin-bottom:1rem;">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" placeholder="Tell us what you need — exterior repaint, interior rooms, roof coating…" required></textarea>
          </div>

          <button type="submit" class="btn-submit">Send My Quote Request</button>
        </form>
      </div>

      <!-- RIGHT: DETAILS -->
      <div class="details-card" aria-label="Contact details">
        <div>
          <span class="section-eyebrow">Reach Us Directly</span>
          <h2>We're Here To Help</h2>
        </div>

        <div class="detail-item">
          <div class="detail-icon" aria-hidden="true">📞</div>
          <div class="detail-text">
            <span class="detail-label">Call Us</span>
            <span class="detail-value"><a href="tel:+353838922620">+353 83 892 2620</a></span>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon" aria-hidden="true">💬</div>
          <div class="detail-text">
            <span class="detail-label">WhatsApp</span>
            <span class="detail-value"><a href="https://wa.me/353838922620" target="_blank" rel="noopener noreferrer">Message on WhatsApp</a></span>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon" aria-hidden="true">✉️</div>
          <div class="detail-text">
            <span class="detail-label">Email</span>
            <span class="detail-value"><a href="mailto:kilkennycountypainter@gmail.com">kilkennycountypainter@gmail.com</a></span>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon" aria-hidden="true">📍</div>
          <div class="detail-text">
            <span class="detail-label">Based In</span>
            <span class="detail-value">Kilkenny, Ireland</span>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon" aria-hidden="true">🕐</div>
          <div class="detail-text">
            <span class="detail-label">Business Hours</span><!-- VERIFY hours -->
            <div class="hours-table">
              <div><span>Mon – Fri</span> 8:00am – 6:00pm</div>
              <div><span>Saturday</span> 9:00am – 1:00pm</div>
              <div><span>Sunday</span> Closed</div>
            </div>
          </div>
        </div>

        <!--
        <div class="review-snippet" aria-label="Customer review">
          <span class="review-stars" aria-label="5 out of 5 stars">★★★★★</span>
          <p class="review-text">"Kevin and the team were brilliant to deal with, very professional job with updates throughout. We are delighted with the new outdoor space!"</p>
          <span class="review-author">— Kimberly, Tipperary · 5.0 ★ Google Review</span>
        </div>
        -->
      </div>

    </div>
  </section>

  <!-- MAP -->
  <section class="map-section" aria-labelledby="map-heading">
    <span class="section-eyebrow">Find Us</span>
    <h2 id="map-heading">Based in Kilkenny</h2>
    <div class="map-embed">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d38725.03606191566!2d-7.287334738767924!3d52.65429215656471!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x641e37625a838b33%3A0x6677ace08ee2d109!2sKilkenny%20county%20painters!5e0!3m2!1sen!2sie!4v1785851832866!5m2!1sen!2sie" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
