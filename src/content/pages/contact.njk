    },
    "url": "https://kilkennycountypainters.ie/"
  }
}
</script>

<div class="kilkenny-county-painters-contact">

  <!-- HERO -->
  <section class="contact-hero" aria-labelledby="contact-h1">
    <div class="contact-hero-inner">
      <span class="contact-hero-eyebrow">Free Quotes · Fast Response</span>
